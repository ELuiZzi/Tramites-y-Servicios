rules_version = '2';

// Reglas de Firestore para Copy & Print.
// Pégalas en: Firebase Console → Firestore Database → Reglas → Publicar.
// Reemplaza UID_DEL_USUARIO por el "UID de usuario" que aparece en
// Firebase Console → Authentication → Usuarios (uno por cada usuario permitido).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.uid in [
          'UID_DEL_USUARIO'
        ];
    }

    match /settings/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Reglas de Firestore para Copy & Print.
// Pégalas en: Firebase Console → Firestore Database → Reglas → Publicar.
// La configuración es pública (solo páginas web y textos; respaldo en el .json
// exportable) pero, a diferencia del "modo de prueba", estas reglas no caducan.
service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{docId} {
      allow read, write: if true;
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

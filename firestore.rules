rules_version = '2';

// Reglas de Firestore para Copy & Print.
// Pégalas en: Firebase Console → Firestore Database → Reglas → Publicar.
// Reemplaza TU_CORREO@gmail.com por la(s) cuenta(s) de Google que pueden usar la app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'TU_CORREO@gmail.com'
        ];
    }

    match /settings/{docId} {
      allow read, write: if isAllowedUser();
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
